+/* Keep cancellation pending until the initial tracee has a registered pid and
+ * the event loop can terminate and reap it. The guest inherits the old mask. */
+static sigset_t original_signal_mask;
+static volatile sig_atomic_t termination_requested;
+
+int block_termination_signals(void)
+{
+	sigset_t mask;
+	sigemptyset(&mask);
+	sigaddset(&mask, SIGTERM);
+	sigaddset(&mask, SIGQUIT);
+	return sigprocmask(SIG_BLOCK, &mask, &original_signal_mask);
+}
+
+static int restore_signal_mask(void)
+{
+	return sigprocmask(SIG_SETMASK, &original_signal_mask, NULL);
+}
