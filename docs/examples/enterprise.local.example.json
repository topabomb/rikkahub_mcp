{
  "formatVersion": 1,
  "identity": {
    "authority": {
      "sourceNamespace": "local:example",
      "deploymentId": "dep_example"
    },
    "enterpriseName": "示例企业",
    "userId": "usr_example",
    "userName": "示例成员"
  },
  "configuration": {
    "generation": 1,
    "policy": {
      "allowLocalProviders": true,
      "allowLocalTts": true,
      "allowLocalAsr": true,
      "allowLocalMcp": true,
      "allowLocalAssistants": true
    },
    "models": [
      {
        "id": "mdl_chat",
        "name": "企业示例对话模型",
        "modelId": "example-chat",
        "type": "CHAT",
        "inputModalities": [
          "TEXT",
          "IMAGE"
        ],
        "outputModalities": [
          "TEXT"
        ],
        "abilities": [
          "TOOL"
        ]
      },
      {
        "id": "mdl_image",
        "name": "企业示例图像模型",
        "modelId": "example-image",
        "type": "IMAGE",
        "inputModalities": [
          "TEXT",
          "IMAGE"
        ],
        "outputModalities": [
          "IMAGE"
        ]
      }
    ],
    "tts": [
      {
        "id": "tts_example",
        "name": "企业示例朗读",
        "modelId": "example-tts",
        "voice": "example"
      }
    ],
    "asr": [
      {
        "id": "asr_example",
        "name": "企业示例转写",
        "modelId": "example-asr"
      }
    ],
    "mcpServers": [
      {
        "id": "mcp_example",
        "name": "企业示例工具",
        "enabled": true
      }
    ],
    "assistants": [
      {
        "id": "asd_main",
        "name": "企业工作助手",
        "description": "体验企业模型、固定工具与子助手协作。",
        "modelId": "mdl_chat",
        "systemPrompt": "你是示例企业工作助手。根据企业资料帮助用户完成任务，明确标注模拟结果。",
        "mcpServerIds": [
          "mcp_example"
        ],
        "memorySeedIds": [
          "seed_company"
        ],
        "allowedSubAssistantIds": [
          "asd_child"
        ]
      },
      {
        "id": "asd_child",
        "name": "企业资料助手",
        "description": "供工作助手委派的资料整理助手。",
        "modelId": "mdl_chat",
        "systemPrompt": "整理调用者提供的资料，输出简明结论。示例数据需标明来源。",
        "mcpServerIds": [
          "mcp_example"
        ],
        "memorySeedIds": [
          "seed_company"
        ],
        "allowAsSubAssistant": true
      }
    ],
    "memorySeeds": [
      {
        "id": "seed_company",
        "content": "这是完全运行在本机的示例企业，所提供的示例业务数据不代表真实企业。"
      }
    ],
    "starters": [
      {
        "id": "str_tools",
        "assistantId": "asd_main",
        "title": "体验企业工具",
        "prompt": "请调用企业示例工具查询企业信息，并整理结论。"
      },
      {
        "id": "str_delegate",
        "assistantId": "asd_main",
        "title": "体验子助手",
        "prompt": "请委派企业资料助手，整理示例企业信息。"
      }
    ],
    "gateways": [
      {
        "id": "gw_required",
        "name": "企业必需工具网关",
        "enablement": "REQUIRED"
      },
      {
        "id": "gw_optional",
        "name": "企业可选工具网关",
        "enablement": "USER_CONTROLLABLE_DEFAULT_ON"
      }
    ],
    "defaults": {
      "assistantId": "asd_main",
      "chatModelId": "mdl_chat",
      "fastModelId": "mdl_chat",
      "titleModelId": "mdl_chat",
      "imageGenerationModelId": "mdl_image",
      "attachmentInspectionModelId": "mdl_chat",
      "suggestionModelId": "mdl_chat",
      "compressModelId": "mdl_chat",
      "ttsId": "tts_example",
      "asrId": "asr_example"
    },
    "feed": [
      {
        "id": "feed_welcome",
        "title": "欢迎体验企业空间",
        "content": "模型、工具、语音、工作台与配置规则均可通过本地示例体验。个人空间保留原配置。"
      }
    ],
    "portal": {
      "title": "示例企业工作台",
      "html": "<!doctype html><html lang=\"zh-CN\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>示例企业工作台</title><style>body{font:16px system-ui;margin:24px;line-height:1.6}button{margin:8px;padding:12px}#result{white-space:pre-wrap}</style><h1>示例企业工作台</h1><p>本地模拟 · 企业信息与手机能力体验</p><p>企业策略和资源来自本地企业服务。此工作台不会取得用户或企业的连接凭据。</p><div id=\"actions\"><button data-method=\"getStatus\">查看状态</button><button data-method=\"refresh\">更新配置</button><button data-method=\"capturePhoto\">拍照</button><button data-method=\"startRecording\">开始录音</button><button data-method=\"stopRecording\">停止录音</button><button data-method=\"cancelRecording\">取消录音</button><button data-method=\"requestLogout\">退出企业</button><button data-method=\"close\">关闭工作台</button></div><pre id=\"result\" role=\"status\">正在等待原生工作台连接。</pre><script>let sequence=0;document.getElementById('actions').onclick=function(event){const method=event.target.dataset.method;if(!method)return;const bridge=window.enterprise;if(!bridge){document.getElementById('result').textContent='请在 App 企业工作台中打开此页面。';return;}bridge.postMessage(JSON.stringify({requestId:String(++sequence),method:method,params:{}}));};window.onEnterpriseResponse=function(response){document.getElementById('result').textContent=JSON.stringify(response,null,2);};</script></html>"
    }
  },
