          "params",
          "documentId"
        ],
        "properties": {
          "bridgeVersion": {
            "type": "integer",
            "enum": [
              3
            ]
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "method": {
            "type": "string",
            "enum": [
              "getStatus"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          },
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
