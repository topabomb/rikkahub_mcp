      },
      "BridgeResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "bridgeVersion",
              "requestId",
              "result",
              "documentId"
            ],
            "properties": {
              "bridgeVersion": {
                "type": "integer",
                "enum": [
                  3
                ]
              },
              "requestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "result": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/HostStatus"
                  },
                  {
                    "$ref": "#/components/schemas/MediaHandle"
                  },
                  {
                    "$ref": "#/components/schemas/MediaChunk"
                  },
                  {
                    "$ref": "#/components/schemas/EmptyResult"
                  }
                ],
                "description": "Extensible result object; the consumer must validate the result schema for the captured request method."
              },
              "documentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "not": {
              "required": [
                "error"
              ]
            }
          },
          {
            "type": "object",
            "required": [
              "bridgeVersion",
              "requestId",
