<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- 存量文案/资源风格类提示：不影响编译与运行，忽略以聚焦真正的代码问题 -->
    <issue id="TypographyEllipsis" severity="ignore" />
    <issue id="TypographyDashes" severity="ignore" />
    <issue id="Typos" severity="ignore" />

    <!-- 存量资源与多语言候选提示 -->
    <issue id="UnusedResources" severity="ignore" />
    <issue id="PluralsCandidate" severity="ignore" />

    <!-- 依赖/构建版本提示（由升级依赖统一处理，不在代码中逐条压制） -->
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />

    <!-- 启动图标/资源位置规范提示 -->
    <issue id="IconLauncherShape" severity="ignore" />
    <issue id="IconLocation" severity="ignore" />

    <!-- 存量硬编码方向与 native 库对齐提示 -->
    <issue id="RtlHardcoded" severity="ignore" />
    <issue id="Aligned16KB" severity="ignore" />

    <!-- SDK API 使用提示 -->
    <issue id="InlinedApi" severity="ignore" />
    <issue id="ObsoleteSdkInt" severity="ignore" />
    <issue id="DiscouragedPrivateApi" severity="ignore" />
</lint>
